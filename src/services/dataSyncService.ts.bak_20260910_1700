import { format } from 'date-fns';
import { StockData } from '@/types';

const SYNC_TIME_KEY = 'tsbs_last_data_sync_time';
const SNAPSHOT_KEY_PREFIX = 'tsbs_local_snapshot_';
const INDUSTRY_MAP_KEY = 'tsbs_industry_map';

export interface SyncStatus {
    hasData: boolean;
    lastSyncTime: string | null;
    totalStocks: number;
}

export const DataSyncService = {
    /**
     * 取得目前本地數據儲存狀態與時間戳記
     */
    getStatus: (): SyncStatus => {
        if (typeof window === 'undefined') {
            return { hasData: false, lastSyncTime: null, totalStocks: 0 };
        }

        const syncTime = localStorage.getItem(SYNC_TIME_KEY) || sessionStorage.getItem(SYNC_TIME_KEY);
        const twse = DataSyncService.getLocalSnapshot('TWSE');
        const tpex = DataSyncService.getLocalSnapshot('TPEX');
        const total = twse.length + tpex.length;

        return {
            hasData: total > 0,
            lastSyncTime: syncTime,
            totalStocks: total
        };
    },

    /**
     * 讀取本地已儲存的市場股票快照數據
     */
    getLocalSnapshot: (market: 'TWSE' | 'TPEX' | 'ALL' = 'TWSE'): StockData[] => {
        if (typeof window === 'undefined') return [];

        try {
            if (market === 'ALL') {
                const twse = DataSyncService.getLocalSnapshot('TWSE');
                const tpex = DataSyncService.getLocalSnapshot('TPEX');
                return [...twse, ...tpex];
            }

            const key = `${SNAPSHOT_KEY_PREFIX}${market}`;
            const cached = localStorage.getItem(key) || sessionStorage.getItem(key);
            return cached ? JSON.parse(cached) : [];
        } catch (e) {
            console.error('[DataSync] Read local snapshot failed:', e);
            return [];
        }
    },

    /**
     * 一鍵批量下載全市場最新股票數據並儲存至本地內部數據庫
     */
    /**
     * 一鍵平滑下載全市場最新股票數據並儲存至本地內部數據庫
     */
    downloadLatestMarketData: async (
        onProgress?: (progress: { stage: string; percent: number }) => void
    ): Promise<{ success: boolean; timestamp: string; count: number; error?: string }> => {
        try {
            const fetchJsonSafely = async (url: string) => {
                try {
                    const res = await fetch(url);
                    if (!res.ok) {
                        const text = await res.text().catch(() => '');
                        console.warn(`[DataSync] HTTP ${res.status} for ${url}: ${text.slice(0, 100)}`);
                        return { success: false, error: `HTTP ${res.status}` };
                    }
                    return await res.json();
                } catch (e: any) {
                    console.warn(`[DataSync] Fetch failed for ${url}:`, e);
                    return { success: false, error: e.message };
                }
            };

            // 步驟 1: 下載上市 (TWSE) 快照
            onProgress?.({ stage: '1/3 正在下載上市股票快照 (TWSE)...', percent: 15 });
            const twseJson = await fetchJsonSafely('/api/market/snapshot?market=TWSE&sector=ALL&refresh=true');
            const twseData: StockData[] = (twseJson && twseJson.success && Array.isArray(twseJson.data)) ? twseJson.data : [];

            // 步驟 2: 下載上櫃 (TPEX) 快照
            onProgress?.({ stage: '2/3 正在下載上櫃股票快照 (TPEX)...', percent: 50 });
            const tpexJson = await fetchJsonSafely('/api/market/snapshot?market=TPEX&sector=AL&refresh=true');
            const tpexData: StockData[] = (tpexJson && tpexJson.success && Array.isArray(tpexJson.data)) ? tpexJson.data : [];

            // 步驟 3: 下載產業類別 Mapping
            onProgress?.({ stage: '3/3 正在下載產業對應數據...', percent: 80 });
            const mapJson = await fetchJsonSafely('/api/market/industry-mapping?refresh=true');
            const industryMap = (mapJson && mapJson.success) ? mapJson.data : {};

            if (twseData.length === 0 && tpexData.length === 0) {
                throw new Error('證交所與上櫃 API 目前忙碌中，請稍後重試');
            }

            onProgress?.({ stage: '寫入網站內部數據倉庫中...', percent: 90 });

            // 儲存至 Storage
            const nowStr = format(new Date(), 'yyyy-MM-dd HH:mm:ss');

            try {
                if (twseData.length > 0) localStorage.setItem(`${SNAPSHOT_KEY_PREFIX}TWSE`, JSON.stringify(twseData));
                if (tpexData.length > 0) localStorage.setItem(`${SNAPSHOT_KEY_PREFIX}TPEX`, JSON.stringify(tpexData));
                if (Object.keys(industryMap).length > 0) localStorage.setItem(INDUSTRY_MAP_KEY, JSON.stringify(industryMap));
                localStorage.setItem(SYNC_TIME_KEY, nowStr);
            } catch (storageError) {
                console.warn('[DataSync] localStorage full, fallback to sessionStorage');
                if (twseData.length > 0) sessionStorage.setItem(`${SNAPSHOT_KEY_PREFIX}TWSE`, JSON.stringify(twseData));
                if (tpexData.length > 0) sessionStorage.setItem(`${SNAPSHOT_KEY_PREFIX}TPEX`, JSON.stringify(tpexData));
                if (Object.keys(industryMap).length > 0) sessionStorage.setItem(INDUSTRY_MAP_KEY, JSON.stringify(industryMap));
                sessionStorage.setItem(SYNC_TIME_KEY, nowStr);
            }

            const totalCount = twseData.length + tpexData.length;
            onProgress?.({ stage: `下載完成！已載入 ${totalCount} 檔股票`, percent: 100 });

            return {
                success: true,
                timestamp: nowStr,
                count: totalCount
            };

        } catch (e: any) {
            console.error('[DataSync] Download failed:', e);
            return {
                success: false,
                timestamp: '',
                count: 0,
                error: e.message || '數據下載失敗'
            };
        }
    }
};
